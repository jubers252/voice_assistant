# Voice Assistant Configuration
# Copy this to .env in your project root directory

# Microphone Digital Gain Settings
# Adjust based on your test results and environment
# 
# Recommended values:
# - Quiet environments: 2.5-3.0
# - Normal environments: 2.0-2.5  
# - Noisy environments: 1.8-2.0
# - If getting false wake words: Lower this value
# - If need louder speech: Raise this value
MIC_GAIN=3.5

# Wake Word Detection Thresholds (if you want to override defaults)
# ENERGY_THRESHOLD=0.050
# CONFIDENCE_THRESHOLD=0.85

# Other settings you can add:
# DEBUG_MODE=True
# LED_BRIGHTNESS=1.0